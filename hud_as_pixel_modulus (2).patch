# Coin count is now pixel count mod 6
# Life count is now pixel count mod 20
# HUD shows a C in the life count
# if you press y it shows your y-position mod 20

add frame_1/DoAction.as 994
begin-patch
if(Key.isDown(89))
{
   _loc3_ = 240 - player._y;
}
else
{
   _loc3_ = player._x - this.level._x;
}
aff(_loc3_ % 6,2,this.hud.coin);
aff(_loc3_ % 20,3,this.hud.life);
aff("C",1,this.hud.life);
end-patch