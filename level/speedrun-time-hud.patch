begin-patch
_root.gametime++;
if (_root.inclevel) {
	_root.leveltime2++;
}

   if(Key.isDown(81) && Key.isDown(16))
   {
      display_time = 0;
   }
   if(Key.isDown(87) && Key.isDown(16))
